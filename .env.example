DISCORD_MODE=bot
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_USER_TOKEN=your_discord_user_token
# Optional: limit ingestion to one channel (omit to monitor all channels)
SIGNAL_CHANNEL_ID=discord_channel_id_to_monitor
# Optional: LLM fallback for follow-up messages the regex parser can't map.
# Leave blank to disable (messages then go to the needs_label queue).
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5
